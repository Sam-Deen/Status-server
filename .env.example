# Copy to .env and replace the password with a unique random value (at least 16 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# true for HTTPS access through Caddy; use false only for local HTTP admin access.
COOKIE_SECURE=true
# Host binding and port for Caddy to reach the application.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8088
# Set true only if you explicitly want the socket proxy in the Docker monitor list.
INCLUDE_PROXY_CONTAINER=false
# Optional active-check freshness and HTTP/TCP latency thresholds.
HEALTH_MONITOR_FRESHNESS_FACTOR=2
HEALTH_RESPONSE_SLOW_MS=2000
